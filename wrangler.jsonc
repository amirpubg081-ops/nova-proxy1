{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "03f15351-5f63-414c-9fc0-cff9d8305274","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "19d3cd11e1ca42d1bcf44f61b6e69877" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
